Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Only the app entry point and its own assets are served; data, users and code are refused.
  RewriteRule (^|/)\.data(/|$) - [F,L]
  # Clean public addresses for the privacy policy, the terms and Facebook's data deletion instructions
  RewriteRule ^privacy/?$ index.php?privacy=1 [L,QSA]
  RewriteRule ^terms/?$ index.php?terms=1 [L,QSA]
  RewriteRule ^welcome/?$ index.php?landing=1 [L,QSA]
  RewriteRule ^welcome2/?$ index.php?landing=1&v=2 [L,QSA]
  RewriteRule ^welcome3/?$ index.php?landing=1&v=3 [L,QSA]
  RewriteRule ^welcome4/?$ index.php?landing=1&v=4 [L,QSA]
  RewriteRule ^welcome6/?$ index.php?landing=1&v=6 [L,QSA]
  RewriteRule ^welcome1/?$ index.php?landing=1&v=1 [L,QSA]
  RewriteRule ^data-deletion/?$ index.php?privacy=1 [L,QSA]
  # the installable app (PWA): its manifest, icons and service worker
  RewriteRule ^manifest\.webmanifest$ index.php?pwa=manifest [L,QSA]
  RewriteRule ^sw\.js$ index.php?pwa=sw [L,QSA]
  RewriteRule ^pwa-(192|512)\.png$ index.php?pwa=icon&s=$1 [L,QSA]
  RewriteRule ^pwa-512m\.png$ index.php?pwa=icon&s=512&m=1 [L,QSA]
  RewriteRule ^fariek\.apk$ index.php?pwa=apk [L,QSA]
  # Integrations API with clean addresses (api host): /v1/send, /v1/media
  RewriteRule ^v1/(send|media)/?$ index.php?int_api=$1 [L,QSA]
  # the OpenWA (WAHA style) addresses, for programs made for that gateway
  RewriteRule ^api/health/?$ index.php?int_api=health [L,QSA]
  RewriteRule ^api/sessions/?$ index.php?int_api=sessions [L,QSA]
  RewriteRule ^api/sessions/[^/]+/?$ index.php?int_api=session [L,QSA]
  RewriteRule ^api/sessions/[^/]+/messages/send-text/?$ index.php?int_api=send_text [L,QSA]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule !(^|/)(index\.php|install\.php|pricing\.php|app\.css|app\.js|features\.js|theme\.css|pro\.css|google\.css|orchid\.css|studio\.css|aurora\.css|fq-violet\.css|fq-night\.css|fq-ink\.css|fq-dawn\.css|fq-meta\.css)$ - [F,L]
</IfModule>
<FilesMatch "\.(json|jsonl|log|md|txt)$">
  Require all denied
</FilesMatch>
